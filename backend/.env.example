# Copy this file to .env and fill in your own values.
# Do NOT commit your real .env file.

# --- Security ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_a_long_random_string

# --- Database ---
DATABASE_URL=sqlite:///./medical_assistant.db

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
# Optional — without it, the app falls back to deterministic template
# explanations so it still runs, just with less rich AI commentary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Google Places API (for "nearby specialists") ---
# Enable the "Places API" in Google Cloud Console and generate a key.
# Optional — without it, the specialist search returns an empty list with a note.
GOOGLE_PLACES_API_KEY=

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
